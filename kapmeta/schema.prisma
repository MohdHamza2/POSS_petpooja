  payment_terms   String?           @db.VarChar(255)
  is_active       Boolean           @default(true)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  created_by      String?           @db.Uuid
  updated_by      String?           @db.Uuid
  purchase_orders purchase_orders[]

  @@index([outlet_id], map: "idx_vendors_outlet")
}

model Invoice {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId         String   @map("outlet_id") @db.Uuid
  orderId          String   @map("order_id") @db.Uuid
  splitIndex       Int      @default(0) @map("split_index")
  invoiceNumber    String   @map("invoice_number") @db.VarChar(64)
  amountMinor      BigInt   @map("amount_minor")
  taxAmountMinor   BigInt   @default(0) @map("tax_amount_minor")
  waivedOffMinor   BigInt   @default(0) @map("waived_off_minor")
  waivedOffReason  String?  @map("waived_off_reason")
  reprintCount     Int      @default(0) @map("reprint_count")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order            Order    @relation(fields: [orderId], references: [id])

  @@unique([orderId, splitIndex], map: "uq_invoices_order_split")
  @@unique([outletId, invoiceNumber])
  @@index([outletId], map: "idx_invoices_outlet")
  @@map("invoices")
}

model InventoryConsumptionLog {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId          String   @map("outlet_id") @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  orderItemId       String   @map("order_item_id") @db.Uuid
  ingredientId      String   @map("ingredient_id") @db.Uuid
  recipeId          String   @map("recipe_id") @db.Uuid
  quantityDeducted  Decimal  @map("quantity_deducted") @db.Decimal(12, 3)
  remainingStock    Decimal? @map("remaining_stock") @db.Decimal(12, 3)
  shortage          Decimal  @default(0) @db.Decimal(12, 3)
  reasonCode        String   @map("reason_code") @db.VarChar(50)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([orderItemId, ingredientId, recipeId], map: "uq_consumption_line_ing_recipe")
  @@index([orderId], map: "idx_consumption_log_order")
  @@index([outletId], map: "idx_consumption_log_outlet")
  @@map("inventory_consumption_log")
}

model OutboxEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId    String    @map("outlet_id") @db.Uuid
  eventType   String    @map("event_type") @db.VarChar(100)
  payload     Json
  status      String    @default("PENDING") @db.VarChar(20)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)

  @@index([status, createdAt], map: "idx_outbox_pending")
  @@map("outbox_events")
}

model WaiterShiftHandover {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId               String   @map("outlet_id") @db.Uuid
  waiterId               String   @map("waiter_id") @db.Uuid
  waiterName             String   @map("waiter_name")
  businessDate           DateTime @map("business_date") @db.Date
  actualCashCountedMinor BigInt   @map("actual_cash_counted_minor")
  openingFloatMinor      BigInt   @map("opening_float_minor")
  netTipPayoutMinor      BigInt   @map("net_tip_payout_minor")
  digitalTipsMinor       BigInt   @default(0) @map("digital_tips_minor")
  serviceChargeMinor     BigInt   @default(0) @map("service_charge_minor")
  cashSalesMinor         BigInt   @default(0) @map("cash_sales_minor")
  managerNotes           String?  @map("manager_notes")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([outletId, businessDate], map: "idx_waiter_shift_handovers_outlet_date")
  @@index([waiterId], map: "idx_waiter_shift_handovers_waiter")
  @@map("waiter_shift_handovers")
}

model InventoryWastageLog {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId       String      @map("outlet_id") @db.Uuid
  ingredientId   String      @map("ingredient_id") @db.Uuid
  quantity       Decimal     @db.Decimal(10, 3)
  reason         String
  loggedAt       DateTime    @default(now()) @map("logged_at") @db.Timestamptz(6)
  loggedBy       String      @map("logged_by") @db.Uuid
  financeEntryId String?     @map("finance_entry_id") @db.Uuid
  ingredients    ingredients @relation(fields: [ingredientId], references: [id])

  @@index([outletId], map: "idx_wastage_log_outlet")
  @@index([ingredientId], map: "idx_wastage_log_ingredient")
  @@map("inventory_wastage_log")
}

