generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String?    @unique @db.Citext
  phone        String?
  full_name    String?    @default("")
  firstName    String?    @map("first_name")
  lastName     String?    @map("last_name")
  passwordHash String     @map("password_hash")
  pinHash      String?    @map("pin_hash")
  mfaEnabled   Boolean    @default(false) @map("mfa_enabled")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy    String?    @map("created_by") @db.Uuid
  updatedBy    String?    @map("updated_by") @db.Uuid
  userRoles     UserRole[]
  sessions      Session[]
  quickLinks    UserQuickLink[]
  notifications Notification[]

  @@map("users")
}

model Role {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String           @unique
  name            String
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String           @unique
  module          String
  description     String?
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  outletId   String?  @map("outlet_id") @db.Uuid
  granted_at DateTime @default(now()) @db.Timestamptz(6)
  granted_by String?  @db.Uuid
  user       User     @relation(fields: [userId], references: [id])
  role       Role     @relation(fields: [roleId], references: [id])
  outlet     Outlet?  @relation(fields: [outletId], references: [id])

  @@index([outletId], map: "idx_user_roles_outlet")
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  outletId           String?   @map("outlet_id") @db.Uuid
  refresh_token_hash String
  tokenHash          String?   @unique @map("token_hash")
  ipAddress          String?   @map("ip_address") @db.Inet
  userAgent          String?   @map("user_agent")
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user               User      @relation(fields: [userId], references: [id])

  @@map("sessions")
}

model AuditLog {
  id          String       @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId    String       @map("outlet_id") @db.Uuid
  entityType  String       @map("entity_type")
  entityId    String       @map("entity_id") @db.Uuid
  action      audit_action
  actor_id    String?      @db.Uuid
  beforeState Json?        @map("before_state")
  afterState  Json?        @map("after_state")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at  DateTime     @default(now()) @db.Timestamptz(6)
  created_by  String?      @db.Uuid
  updated_by  String?      @db.Uuid

  @@id([id, createdAt])
  @@map("audit_logs")
}

model Organization {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  legal_name String?
  tax_id     String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy  String?  @map("created_by") @db.Uuid
  updatedBy  String?  @map("updated_by") @db.Uuid

  @@map("organizations")
}

model Outlet {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  code           String
  name           String
  timezone       String     @default("Asia/Kolkata")
  currency       String     @default("INR") @db.Char(3)
  dayStartTime   DateTime   @default(dbgenerated("'05:00:00'::time without time zone")) @map("day_start_time") @db.Time(6)
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy             String?    @map("created_by") @db.Uuid
  updatedBy             String?    @map("updated_by") @db.Uuid
  loyaltyPaisePerPoint  BigInt?    @map("loyalty_paise_per_point")
  userRoles             UserRole[]

  @@unique([organizationId, code])
  @@index([organizationId], map: "idx_outlets_org")
  @@map("outlets")
}

model Station {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId          String      @map("outlet_id") @db.Uuid
  name              String
  printerIp         String?     @map("printer_ip")
  slaWarningSeconds Int?        @default(300) @map("sla_warning_seconds")
  slaBreachSeconds  Int?        @default(600) @map("sla_breach_seconds")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy         String?     @map("created_by") @db.Uuid
  updatedBy         String?     @map("updated_by") @db.Uuid
  kotTickets        KOTTicket[]

  @@index([outletId], map: "idx_stations_outlet")
  @@map("stations")
}

model MenuCategory {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId           String     @map("outlet_id") @db.Uuid
  name               String
  description        String?
  online_display_name String?
  sortOrder          Int        @default(0) @map("sort_order")
  isActive           Boolean    @default(true) @map("is_active")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  menuItems          MenuItem[]

  @@unique([outletId, name], map: "ux_menu_categories_outlet_name")
  @@index([outletId], map: "ix_menu_categories_outlet_id")
  @@map("menu_categories")
}

model DiningTable {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId             String   @map("outlet_id") @db.Uuid
  tableNumber          String   @map("table_number")
  capacity             Int      @default(4)
  section              String   @default("General")
  status               String   @default("VACANT")
  isActive             Boolean  @default(true) @map("is_active")
  mergeGroupId         String?  @map("merge_group_id") @db.Uuid
  mergePrimaryTableId  String?  @map("merge_primary_table_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  orders               Order[]

  @@unique([outletId, tableNumber], map: "uq_dining_tables_outlet_number")
  @@index([outletId], map: "idx_dining_tables_outlet")
  @@index([mergeGroupId], map: "idx_dining_tables_merge_group")
  @@map("dining_tables")
}

model UserQuickLink {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  label     String
  href      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "idx_user_quick_links_user")
  @@map("user_quick_links")
}

model MenuItem {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId       String        @map("outlet_id") @db.Uuid
  categoryId     String        @map("category_id") @db.Uuid
  name           String
  description    String?
  price          Decimal?      @default(0) @db.Decimal(12, 2)
  taxRate        Decimal?      @default(5.00) @map("tax_rate") @db.Decimal(5, 2)
  sortOrder      Int?          @default(0) @map("sort_order")
  code           String?
  isVeg          Boolean       @default(true) @map("is_veg")
  hsn_code       String?
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?       @map("created_by") @db.Uuid
  updatedBy      String?       @map("updated_by") @db.Uuid
  category       MenuCategory? @relation(fields: [categoryId], references: [id])
  kotItems       KOTItem[]
  orderItems     OrderItem[]

  @@index([categoryId], map: "idx_menu_items_category")
  @@index([outletId], map: "idx_menu_items_outlet")
  @@map("menu_items")
}

model ModifierGroup {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId   String   @map("outlet_id") @db.Uuid
  name       String
  minSelect  Int      @default(0) @map("min_select")
  maxSelect  Int      @default(1) @map("max_select")
  is_active  Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  created_by String?  @db.Uuid
  updated_by String?  @db.Uuid

  @@index([outletId], map: "idx_modifier_groups_outlet")
  @@map("modifier_groups")
}

model Order {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId            String       @map("outlet_id") @db.Uuid
  orderNumber         String       @map("order_number")
  orderType           order_type   @map("type")
  status              order_status @default(DRAFT)
  business_date       DateTime     @db.Date
  subtotal            BigInt       @default(0) @map("subtotal_minor")
  grandTotal          BigInt       @default(0) @map("total_minor")
  taxTotal            BigInt?      @default(0) @map("tax_total_minor")
  discountTotal       BigInt?      @default(0) @map("discount_total_minor")
  tipTotal            BigInt       @default(0) @map("tip_total_minor")
  serviceChargeTotal  BigInt       @default(0) @map("service_charge_total_minor")
  currency            String       @default("INR") @db.Char(3)
  customerId          String?      @map("customer_id") @db.Uuid
  table_number        String?
  diningTableId       String?      @map("dining_table_id") @db.Uuid
  diningTable         DiningTable? @relation(fields: [diningTableId], references: [id])
  delivery_address_id String?      @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  created_by          String?      @db.Uuid
  updated_by          String?      @db.Uuid
  settledAt           DateTime?    @map("settled_at") @db.Timestamptz(6)
  scheduledFireAt     DateTime?    @map("scheduled_fire_at") @db.Timestamptz(6)
  promisedAt          DateTime?    @map("promised_at") @db.Timestamptz(6)
  depositMinor        BigInt?      @default(0) @map("deposit_minor")
  advanceStatus       String?      @map("advance_status")
  idempotencyKey      String?      @map("idempotency_key")
  orderItems          OrderItem[]
  kotTickets          KOTTicket[]
  invoices            Invoice[]

  @@unique([outletId, orderNumber], map: "uq_orders_outlet_number")
  @@unique([outletId, idempotencyKey], map: "uq_orders_outlet_idempotency")
  @@index([customerId], map: "idx_orders_customer")
  @@index([outletId], map: "idx_orders_outlet")
  @@index([outletId, status, business_date], map: "idx_orders_outlet_status_date")
  @@map("orders")
}

model OrderItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId    String    @map("outlet_id") @db.Uuid
  orderId     String    @map("order_id") @db.Uuid
  menuItemId  String    @map("item_id") @db.Uuid
  variant_id  String?   @db.Uuid
  item_name   String
  quantity    Decimal   @default(1) @map("qty") @db.Decimal
  unitPrice   BigInt    @map("unit_price_minor")
  subtotal    BigInt    @map("total_price_minor")
  isVoided    Boolean   @default(false) @map("is_voided")
  seatNumber  Int?      @map("seat_number")
  course      String?
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  created_by  String?   @db.Uuid
  updated_by  String?   @db.Uuid
  order       Order     @relation(fields: [orderId], references: [id])
  menuItem    MenuItem? @relation(fields: [menuItemId], references: [id])

  @@index([menuItemId], map: "idx_order_items_item")
  @@index([orderId], map: "idx_order_items_order")
  @@index([outletId], map: "idx_order_items_outlet")
  @@index([variant_id], map: "idx_order_items_variant")
  @@map("order_items")
}

model OrderItemModifier {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outlet_id         String   @db.Uuid
  orderItemId       String   @map("order_item_id") @db.Uuid
  modifier_id       String   @db.Uuid
  modifier_name     String
  price_delta_minor BigInt   @default(0)
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @db.Timestamptz(6)
  created_by        String?  @db.Uuid
  updated_by        String?  @db.Uuid

  @@index([modifier_id], map: "idx_order_item_modifiers_modifier")
  @@index([orderItemId], map: "idx_order_item_modifiers_order_item")
  @@index([outlet_id], map: "idx_order_item_modifiers_outlet")
  @@map("order_item_modifiers")
}

model OrderStatusHistory {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId    String        @map("outlet_id") @db.Uuid
  orderId     String        @map("order_id") @db.Uuid
  from_status order_status?
  to_status   order_status
  reason_code String?
  actor_id    String?       @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orderId], map: "idx_order_status_history_order")
  @@index([outletId], map: "idx_order_status_history_outlet")
  @@map("order_status_history")
}

model KOTTicket {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId      String             @map("outlet_id") @db.Uuid
  orderId       String             @map("order_id") @db.Uuid
  stationId     String?            @map("station_id") @db.Uuid
  ticketNumber  String             @map("ticket_number")
  status        String
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  servedAt      DateTime?          @map("served_at") @db.Timestamptz(6)
  order         Order?             @relation(fields: [orderId], references: [id])
  station       Station?           @relation(fields: [stationId], references: [id])
  kotItems      KOTItem[]
  statusHistory KOTStatusHistory[]

  @@index([orderId], map: "idx_kot_tickets_order")
  @@index([outletId], map: "idx_kot_tickets_outlet")
  @@index([stationId], map: "idx_kot_tickets_station")
  @@map("kot_tickets")
}

model KOTItem {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kotTicketId String     @map("kot_ticket_id") @db.Uuid
  menuItemId  String     @map("menu_item_id") @db.Uuid
  orderItemId String?    @map("order_item_id") @db.Uuid
  quantity    Int
  notes       String?
  course      String?
  servedAt    DateTime?  @map("served_at") @db.Timestamptz(6)
  kotTicket   KOTTicket  @relation(fields: [kotTicketId], references: [id])
  menuItem    MenuItem?  @relation(fields: [menuItemId], references: [id])

  @@index([menuItemId], map: "idx_kot_items_menu_item")
  @@index([kotTicketId], map: "idx_kot_items_ticket")
  @@index([orderItemId], map: "idx_kot_items_order_item")
  @@map("kot_items")
}

model KOTStatusHistory {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kotTicketId String    @map("kot_ticket_id") @db.Uuid
  status      String
  reasonCode  String?   @map("reason_code")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  kotTicket   KOTTicket @relation(fields: [kotTicketId], references: [id])

  @@index([kotTicketId], map: "idx_kot_status_history_ticket")
  @@map("kot_status_history")
}

model Customer {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id      String?   @db.Uuid
  outletId             String?   @map("outlet_id") @db.Uuid
  phone                String
  name                 String?
  firstName            String?   @map("first_name")
  lastName             String?   @map("last_name")
  email                String?   @db.Citext
  consent_marketing    Boolean   @default(false)
  consent_data_sharing Boolean   @default(false)
  consent_recorded_at  DateTime? @db.Timestamptz(6)
  loyaltyPoints        Int       @default(0) @map("loyalty_points")
  birthDate            DateTime? @map("birth_date") @db.Date
  isActive             Boolean   @default(true) @map("is_active")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  created_by           String?   @db.Uuid
  updated_by           String?   @db.Uuid

  @@unique([organization_id, phone])
  @@index([organization_id], map: "idx_customers_organization")
  @@map("customers")
}

model MarketingCampaign {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId        String              @map("outlet_id") @db.Uuid
  name            String
  triggerType     String              @default("MANUAL") @map("trigger_type")
  segmentFilter   Json?               @map("segment_filter")
  discountId      String?             @map("discount_id") @db.Uuid
  messageTemplate String              @map("message_template")
  status          String              @default("DRAFT")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       String?             @map("created_by") @db.Uuid
  recipients      CampaignRecipient[]

  @@index([outletId], map: "idx_marketing_campaigns_outlet")
  @@map("marketing_campaigns")
}

model CampaignRecipient {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId   String            @map("campaign_id") @db.Uuid
  customerId   String?           @map("customer_id") @db.Uuid
  status       String            @default("PENDING")
  sentAt       DateTime?         @map("sent_at") @db.Timestamptz(6)
  errorMessage String?           @map("error_message")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  campaign     MarketingCampaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId], map: "idx_campaign_recipients_campaign")
  @@map("campaign_recipients")
}

model Payment {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId      String   @map("outlet_id") @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  paymentId     String   @default(dbgenerated("gen_random_uuid()")) @map("payment_id") @db.Uuid
  amount        BigInt   @default(0) @map("amount_minor")
  method        String   @default("CASH")
  status        String   @default("CAPTURED")
  transactionId String?  @map("transaction_id")
  seatNumber    Int?     @map("seat_number")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([orderId], map: "idx_payments_order")
  @@index([outletId], map: "idx_payments_outlet")
  @@map("order_payments")
}

model Notification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId   String   @map("outlet_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  type       String
  title      String
  message    String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId], map: "idx_notifications_user")
  @@index([outletId], map: "idx_notifications_outlet")
  @@map("notifications")
}

model ChannelAccount {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId         String   @map("outlet_id") @db.Uuid
  integration_id   String   @db.Uuid
  externalOutletId String?  @map("external_outlet_id")
  credentialsRef   String?  @map("credentials_ref")
  is_active        Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  created_by       String?  @db.Uuid
  updated_by       String?  @db.Uuid

  @@map("channel_accounts")
}

model ChannelItemMapping {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outlet_id        String   @db.Uuid
  channelAccountId String   @map("channel_account_id") @db.Uuid
  item_id          String   @db.Uuid
  externalItemId   String   @map("external_item_id")
  created_at       DateTime @default(now()) @db.Timestamptz(6)
